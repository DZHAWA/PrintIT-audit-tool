<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PrintIT"
             x:Class="PrintIT.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Глобальный конвертер инверсии булевых значений -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter" />
            <local:PluralConverter x:Key="PluralConverter" />
            <local:IsPositiveConverter x:Key="IsPositiveConverter" />
            <local:IsZeroConverter x:Key="IsZeroConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>