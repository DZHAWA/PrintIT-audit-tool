<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Дизайн-система PrintIT.
        Шрифт не задаём намеренно: используется системный (Segoe UI на Windows, Roboto на Android).
        Шкала отступов: 4 / 8 / 12 / 16 / 24 / 32.
    -->

    <!-- ===== Иконки (контурные, сетка 24×24) ===== -->
    <PathGeometry x:Key="IconPlus" Figures="M12,5 L12,19 M5,12 L19,12"/>
    <PathGeometry x:Key="IconClose" Figures="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5"/>
    <PathGeometry x:Key="IconChevronRight" Figures="M9.5,6 L15.5,12 L9.5,18"/>
    <PathGeometry x:Key="IconTrash" Figures="M4.5,7 L19.5,7 M9.5,7 L9.5,4.5 L14.5,4.5 L14.5,7 M6.5,7 L7.5,19.5 L16.5,19.5 L17.5,7 M10.5,11 L10.5,16 M13.5,11 L13.5,16"/>
    <PathGeometry x:Key="IconPrinter" Figures="M7,9 L7,3.5 L17,3.5 L17,9 M7,17 L4,17 L4,9 L20,9 L20,17 L17,17 M7,14 L17,14 L17,20.5 L7,20.5 Z"/>
    <PathGeometry x:Key="IconDocument" Figures="M6,3.5 L14,3.5 L18.5,8 L18.5,20.5 L6,20.5 Z M14,3.5 L14,8 L18.5,8 M9,12.5 L15.5,12.5 M9,16 L15.5,16"/>
    <PathGeometry x:Key="IconFolder" Figures="M3.5,6.5 L3.5,18.5 L20.5,18.5 L20.5,8.5 L11.5,8.5 L9.5,6 L3.5,6 Z"/>
    <PathGeometry x:Key="IconSearch" Figures="M16.5,10.5 A6,6 0 1 1 4.5,10.5 A6,6 0 1 1 16.5,10.5 Z M15,15 L19.5,19.5"/>
    <PathGeometry x:Key="IconTable" Figures="M4.5,4.5 L19.5,4.5 L19.5,19.5 L4.5,19.5 Z M4.5,9.5 L19.5,9.5 M4.5,14.5 L19.5,14.5 M10,4.5 L10,19.5"/>
    <PathGeometry x:Key="IconCheck" Figures="M5.5,12.5 L10,17 L18.5,7.5"/>

    <!-- ===== Базовые элементы ===== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"/>
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource CanvasDark}}"/>
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"/>
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"/>
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>
        <Setter Property="Shell.NavBarHasShadow" Value="False"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"/>
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
    </Style>

    <Style TargetType="BoxView" x:Key="Divider">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
    </Style>

    <!-- ===== Типографика ===== -->

    <Style TargetType="Label" x:Key="TextDisplay">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineHeight" Value="1.1"/>
    </Style>

    <Style TargetType="Label" x:Key="TextTitle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" x:Key="TextHeading">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style TargetType="Label" x:Key="TextSecondary">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>
    </Style>

    <Style TargetType="Label" x:Key="TextCaption">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
    </Style>

    <Style TargetType="Label" x:Key="TextSectionLabel">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>
    </Style>

    <!-- ===== Иконки ===== -->

    <Style TargetType="Path" x:Key="Icon">
        <Setter Property="WidthRequest" Value="24"/>
        <Setter Property="HeightRequest" Value="24"/>
        <Setter Property="Aspect" Value="None"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="InputTransparent" Value="True"/>
    </Style>

    <Style TargetType="Path" x:Key="IconAccent" BasedOn="{StaticResource Icon}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
    </Style>

    <Style TargetType="Path" x:Key="IconMuted" BasedOn="{StaticResource Icon}">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
    </Style>

    <!-- Квадратная кликабельная зона 40×40 вокруг иконки -->
    <Style TargetType="Border" x:Key="IconButton">
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Строка-кнопка внутри карточки или списка -->
    <Style TargetType="Border" x:Key="RowButton">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Поверхности ===== -->

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 14"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style TargetType="Border" x:Key="CardInteractive" BasedOn="{StaticResource Card}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource InkTertiary}, Dark={StaticResource InkTertiaryDark}}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Поле ввода: Entry без собственной рамки внутри этой подложки -->
    <Style TargetType="Border" x:Key="Field">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
    </Style>

    <Style TargetType="Border" x:Key="FieldSunken" BasedOn="{StaticResource Field}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <!-- Плашка-тег: нейтральная и «нужна замена» -->
    <Style TargetType="Border" x:Key="Tag">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <Style TargetType="Border" x:Key="TagCritical" BasedOn="{StaticResource Tag}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CriticalSoft}, Dark={StaticResource CriticalSoftDark}}"/>
    </Style>

    <Style TargetType="Label" x:Key="TagText">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}"/>
    </Style>

    <Style TargetType="Label" x:Key="TagTextCritical" BasedOn="{StaticResource TagText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Critical}, Dark={StaticResource CriticalDark}}"/>
    </Style>

    <!-- ===== Кнопки ===== -->

    <Style TargetType="Button">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}"/>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="HeightRequest" Value="50"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentHover}, Dark={StaticResource AccentHoverDark}}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceSunken}, Dark={StaticResource SurfaceSunkenDark}}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
