    <Color x:Key="AccentSoftDark">#1E2D28</Color>
    <Color x:Key="OnAccentDark">#0E1A15</Color>
    <Color x:Key="CriticalDark">#EE8E84</Color>
    <Color x:Key="CriticalSoftDark">#3A2321</Color>
    <Color x:Key="ScrimDark">#99000000</Color>
</ResourceDictionary>
