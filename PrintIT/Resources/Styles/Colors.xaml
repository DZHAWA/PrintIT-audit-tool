<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Палитра PrintIT. Для Android см. также Platforms\Android\Resources\values\colors.xml -->

    <!-- Светлая тема -->
    <Color x:Key="Canvas">#F5F4F1</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceSunken">#EEEDE9</Color>
    <Color x:Key="Line">#E2E0DB</Color>
    <Color x:Key="Ink">#1C1D1F</Color>
    <Color x:Key="InkSecondary">#5E6065</Color>
    <Color x:Key="InkTertiary">#8D8F94</Color>
    <Color x:Key="Accent">#1F5C4A</Color>
    <Color x:Key="AccentHover">#184C3D</Color>
    <Color x:Key="AccentSoft">#E4EEEA</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="Critical">#B3362C</Color>
    <Color x:Key="CriticalSoft">#F7E6E3</Color>
    <Color x:Key="Scrim">#661C1D1F</Color>

