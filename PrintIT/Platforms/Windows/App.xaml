<maui:MauiWinUIApplication
    x:Class="PrintIT.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:PrintIT.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- Акцент приложения вместо системного: им окрашены диалоги, поля ввода и переключатели WinUI.
                 Светлая тема берёт Dark1, тёмная — Light2. -->
            <Color x:Key="SystemAccentColor">#1F5C4A</Color>
            <Color x:Key="SystemAccentColorDark1">#1F5C4A</Color>
            <Color x:Key="SystemAccentColorDark2">#184C3D</Color>
            <Color x:Key="SystemAccentColorDark3">#123A2F</Color>
            <Color x:Key="SystemAccentColorLight1">#4E9A80</Color>
            <Color x:Key="SystemAccentColorLight2">#7CC2A6</Color>
            <Color x:Key="SystemAccentColorLight3">#93CFB7</Color>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
